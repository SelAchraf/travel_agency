# Server Environment & Port
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection URL (PERN Stack)
DATABASE_URL=postgresql://travel_user:travel_password_secure_2026@127.0.0.1:5432/travel_agency

# Security Secrets (Minimum 32 characters in production)
JWT_ACCESS_SECRET=dev_access_secret_must_be_at_least_32_characters_long_for_security
JWT_REFRESH_SECRET=dev_refresh_secret_must_be_at_least_32_characters_long_for_security
COOKIE_SECRET=dev_cookie_secret_must_be_at_least_32_characters_long_for_security

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# File Storage
PRIVATE_STORAGE_DIR=./storage/private
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional Notification Hooks
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Numidia Voyages <noreply@numidiavoyages.dz>"
